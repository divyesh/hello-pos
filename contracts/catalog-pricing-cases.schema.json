{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/divyesh/hello-pos/contracts/catalog-pricing-cases.schema.json",
  "title": "Hello POS shared catalog pricing cases",
  "description": "A catalog in the shape a till downloads it (CatalogSync in openapi.yaml) and one-line sales priced from it at given instants. Run by the .NET suite (CatalogPricing) and the Kotlin suite (CatalogPriceFeed) so the till and the server price identically (feature #13, research R9). Money is integer minor units; quantities and rates are invariant decimal strings. Expected values are derived by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "catalogs"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "description": { "type": "string" },
    "catalogs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "catalog", "checks"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "catalog": {
            "description": "A CatalogSync with mode full; validated against the OpenAPI schema by the suites.",
            "type": "object",
            "required": ["mode", "business", "taxProfiles", "categories", "products", "discounts", "paymentTypes", "tableAreas", "tables", "selling"],
            "properties": { "mode": { "const": "full" } }
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/check" }
          }
        }
      }
    }
  },
  "$defs": {
    "minor": { "type": "integer" },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "productId", "at", "quantity", "expected"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "description": { "type": "string", "minLength": 1 },
        "productId": { "type": "string", "format": "uuid" },
        "at": { "type": "string", "format": "date-time", "description": "The instant of the sale; dates are taken in the business's time zone." },
        "quantity": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,3})?$" },
        "enteredPrice": { "$ref": "#/$defs/minor", "description": "For open-price products." },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["taxProfile", "lineAmount", "itemDiscount", "deposit", "taxes", "taxTotal", "total"],
          "properties": {
            "taxProfile": { "type": "string", "description": "Name of the profile in force for the product." },
            "lineAmount": { "$ref": "#/$defs/minor" },
            "itemDiscount": { "$ref": "#/$defs/minor" },
            "deposit": { "$ref": "#/$defs/minor" },
            "taxes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "ratePercent", "amount"],
                "properties": {
                  "label": { "type": "string" },
                  "ratePercent": { "type": "string" },
                  "amount": { "$ref": "#/$defs/minor" }
                }
              }
            },
            "taxTotal": { "$ref": "#/$defs/minor" },
            "total": { "$ref": "#/$defs/minor" }
          }
        }
      }
    }
  }
}
