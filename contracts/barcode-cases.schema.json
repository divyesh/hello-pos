{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/divyesh/hello-pos/contracts/barcode-cases.schema.json",
  "title": "Hello POS shared barcode cases",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "description",
    "cases"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input",
          "valid",
          "description"
        ],
        "properties": {
          "input": {
            "type": "string"
          },
          "valid": {
            "type": "boolean"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "pattern": "^[0-9]{4,13}$"
          },
          "kind": {
            "enum": [
              "ean13",
              "ean8",
              "plu"
            ]
          },
          "reason": {
            "enum": [
              "notDigits",
              "length",
              "checkDigit",
              "pluRange",
              "inStore"
            ]
          }
        },
        "oneOf": [
          {
            "properties": {
              "valid": {
                "const": true
              }
            },
            "required": [
              "code",
              "kind"
            ]
          },
          {
            "properties": {
              "valid": {
                "const": false
              }
            },
            "required": [
              "reason"
            ]
          }
        ]
      }
    }
  }
}
