@using System.Globalization
@inject ICatalogService CatalogApi
@inject TimeProvider Clock

@* Scheduled discounts of one product (feature #11, US3): future ones can go, running ones can end today. *@

<MudPaper Outlined="true" Class="pa-4 mt-4" Style="max-width: 44rem;" data-testid="discounts">
    <MudText Typo="Typo.h6">Scheduled discounts</MudText>

    @if (message is not null)
    {
        <MudAlert data-testid="discount-message" Severity="@(failed ? Severity.Error : Severity.Success)" Dense="true" Class="my-2">@message</MudAlert>
    }

    @if (discounts.Count == 0)
    {
        <MudText data-testid="no-discounts" Typo="Typo.body2">No discounts scheduled.</MudText>
    }
    @foreach (var discount in discounts)
    {
        <div class="d-flex align-center" style="gap: 8px;" data-testid="discount">
            <MudText Class="flex-grow-1">
                <b>@Describe(discount)</b> · @discount.From.ToString("d MMM yyyy", CultureInfo.CurrentCulture)
                @(discount.To is { } end ? $"to {end.ToString("d MMM yyyy", CultureInfo.CurrentCulture)}" : "onward")
                <MudChip T="string" Size="Size.Small" data-testid="discount-status">@discount.Status</MudChip>
            </MudText>
            @if (discount.Status == "running")
            {
                <MudButton data-testid="end-today" Size="Size.Small" Variant="Variant.Text" Disabled="busy" OnClick="() => EndTodayAsync(discount)">End today</MudButton>
            }
            else if (discount.Status == "future")
            {
                <MudButton data-testid="remove-discount" Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Disabled="busy"
                           OnClick="() => RemoveAsync(discount)">Remove</MudButton>
            }
        </div>
    }

    <div class="d-flex align-center flex-wrap mt-3" style="gap: 12px;" data-testid="new-discount">
        <MudSelect T="string" data-testid="discount-kind" Label="Kind" @bind-Value="kind" Style="max-width: 10rem;">
            <MudSelectItem T="string" Value="@("percent")">Percent off</MudSelectItem>
            <MudSelectItem T="string" Value="@("fixed")">Amount off each</MudSelectItem>
        </MudSelect>
        <MudTextField T="string" data-testid="discount-value" Label="@(kind == "percent" ? "Percent" : $"Amount ({Currency})")" @bind-Value="value"
                      Error="@(errors.ContainsKey("value"))" ErrorText="@errors.GetValueOrDefault("value")" Style="max-width: 9rem;" />
        <MudTextField T="string" data-testid="discount-from" Label="From" InputType="InputType.Date" @bind-Value="from"
                      Error="@(errors.ContainsKey("fromDate"))" ErrorText="@errors.GetValueOrDefault("fromDate")" Style="max-width: 11rem;" />
        <MudTextField T="string" data-testid="discount-to" Label="To (optional)" InputType="InputType.Date" @bind-Value="to"
                      Error="@(errors.ContainsKey("toDate"))" ErrorText="@errors.GetValueOrDefault("toDate")" Style="max-width: 11rem;" />
        <MudButton data-testid="schedule" Variant="Variant.Filled" Color="Color.Primary" Disabled="busy" OnClick="ScheduleAsync">Schedule</MudButton>
    </div>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public Guid PageBusiness { get; set; }

    [Parameter, EditorRequired]
    public Guid ProductId { get; set; }

    [Parameter, EditorRequired]
    public string Currency { get; set; } = string.Empty;

    private IReadOnlyList<DiscountItem> discounts = [];
    private string kind = "percent";
    private string value = string.Empty;
    private string from = string.Empty;
    private string to = string.Empty;
    private bool busy;
    private string? message;
    private bool failed;
    private Dictionary<string, string> errors = new(StringComparer.Ordinal);

    private DateOnly Today => DateOnly.FromDateTime(Clock.GetLocalNow().Date);

    protected override async Task OnInitializedAsync()
    {
        from = Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (await CatalogApi.ListDiscountsAsync(PageBusiness, ProductId) is LoadResult<IReadOnlyList<DiscountItem>>.Loaded loaded)
        {
            discounts = loaded.Value;
        }
    }

    private string Describe(DiscountItem discount) =>
        discount.Kind == "percent"
            ? $"{discount.Value}% off"
            : $"{MoneyText.Format(long.Parse(discount.Value, CultureInfo.InvariantCulture), Currency)} off each";

    private async Task ScheduleAsync()
    {
        errors = new(StringComparer.Ordinal);
        var amount = value.Trim();
        if (kind == "fixed")
        {
            var (minor, error) = MoneyText.Parse(value, Currency);
            if (error is not null)
            {
                errors["value"] = error;
                return;
            }

            amount = minor!.Value.ToString(CultureInfo.InvariantCulture);
        }

        if (!DateOnly.TryParseExact(from, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var start))
        {
            errors["fromDate"] = "Choose the first day.";
            return;
        }

        DateOnly? end = DateOnly.TryParseExact(to, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var e) ? e : null;
        if (await ApplyAsync(CatalogApi.SaveDiscountAsync(PageBusiness, ProductId, null, kind, amount, start, end), "The discount is scheduled."))
        {
            (value, to) = (string.Empty, string.Empty);
        }
    }

    private Task EndTodayAsync(DiscountItem discount) =>
        ApplyAsync(CatalogApi.SaveDiscountAsync(PageBusiness, ProductId, discount.Id, discount.Kind, discount.Value, discount.From, Today), "The discount ends today.");

    private Task RemoveAsync(DiscountItem discount) =>
        ApplyAsync(CatalogApi.DeleteDiscountAsync(PageBusiness, ProductId, discount.Id), "The discount was removed.");

    private async Task<bool> ApplyAsync(Task<OwnerActionResult> call, string success)
    {
        busy = true;
        message = null;
        var result = await call;
        busy = false;
        switch (result)
        {
            case OwnerActionResult.Succeeded:
                (message, failed) = (success, false);
                await LoadAsync();
                return true;
            case OwnerActionResult.FieldErrors fields:
                errors = new(fields.Errors, StringComparer.Ordinal);
                (message, failed) = (string.Join(" ", fields.Errors.Values), true);
                return false;
            case OwnerActionResult.Failed changeFailed:
                (message, failed) = (changeFailed.Message, true);
                await LoadAsync();
                return false;
            default:
                return false;
        }
    }
}
