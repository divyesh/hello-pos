@page "/reset-password"
@inject IOwnerAccountService Accounts

<PageTitle>Choose a new password · Hello POS</PageTitle>

<MudPaper Outlined="true" Class="pa-6" Style="max-width: 28rem;">
    <MudText Typo="Typo.h5" GutterBottom="true">Choose a new password</MudText>
    @if (done)
    {
        <div data-testid="reset-done">
            <MudAlert Severity="Severity.Success">Your password is changed. You are signed out on every device.</MudAlert>
            <MudButton Href="sign-in" Class="mt-4" Variant="Variant.Filled" Color="Color.Primary">Sign in</MudButton>
        </div>
    }
    else if (linkInvalid)
    {
        <div data-testid="reset-failed">
            <MudAlert Severity="Severity.Error">@(formError ?? "This link is invalid, already used or expired.")</MudAlert>
            <MudButton Href="forgot-password" Class="mt-4" Variant="Variant.Outlined" Color="Color.Primary">Ask for a new link</MudButton>
        </div>
    }
    else
    {
        <MudTextField data-testid="password" @bind-Value="newPassword" Label="New password" InputType="InputType.Password" Required="true"
                      HelperText="At least 12 characters. A memorable phrase works well."
                      Error="@(passwordError is not null)" ErrorText="@passwordError" />
        <MudButton data-testid="submit" Class="mt-4" Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="busy" OnClick="SubmitAsync">Change password</MudButton>
    }
</MudPaper>

@code {
    private string newPassword = string.Empty;
    private string? passwordError;
    private string? formError;
    private bool linkInvalid;
    private bool busy;
    private bool done;
    private Guid ownerId;

    [SupplyParameterFromQuery(Name = "owner")]
    public string? Owner { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    protected override void OnInitialized() =>
        linkInvalid = !Guid.TryParse(Owner, out ownerId) || string.IsNullOrEmpty(Token);

    private async Task SubmitAsync()
    {
        busy = true;
        passwordError = null;
        var result = await Accounts.ResetPasswordAsync(ownerId, Token!, newPassword);
        busy = false;
        switch (result)
        {
            case OwnerActionResult.Succeeded:
                done = true;
                newPassword = string.Empty;
                break;
            case OwnerActionResult.FieldErrors fields:
                passwordError = fields.Errors.GetValueOrDefault("newPassword") ?? string.Join(" ", fields.Errors.Values);
                break;
            case OwnerActionResult.Failed failed:
                formError = failed.Message;
                linkInvalid = true;
                break;
        }
    }
}
