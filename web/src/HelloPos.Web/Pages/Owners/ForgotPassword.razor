@page "/forgot-password"
@inject IOwnerAccountService Accounts

<PageTitle>Forgot password · Hello POS</PageTitle>

<MudPaper Outlined="true" Class="pa-6" Style="max-width: 28rem;">
    <MudText Typo="Typo.h5" GutterBottom="true">Forgot password</MudText>
    @if (done)
    {
        <div data-testid="forgot-done">
            <MudText>If <b>@email</b> has a Hello POS account, we sent it a link to choose a new password. The link works for 1 hour.</MudText>
            <MudButton Href="sign-in" Class="mt-4" Variant="Variant.Outlined" Color="Color.Primary">Back to sign in</MudButton>
        </div>
    }
    else
    {
        <MudText Typo="Typo.body2">Enter your email and we will send you a link to choose a new password.</MudText>
        <MudTextField data-testid="email" @bind-Value="email" Label="Email" InputType="InputType.Email" Required="true"
                      Error="@(emailError is not null)" ErrorText="@emailError" />
        @if (formError is not null)
        {
            <MudAlert data-testid="form-error" Severity="Severity.Error" Dense="true" Class="mt-3">@formError</MudAlert>
        }
        <MudButton data-testid="submit" Class="mt-4" Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="busy" OnClick="SubmitAsync">Send link</MudButton>
    }
</MudPaper>

@code {
    private string email = string.Empty;
    private string? emailError;
    private string? formError;
    private bool busy;
    private bool done;

    private async Task SubmitAsync()
    {
        busy = true;
        emailError = null;
        formError = null;
        var result = await Accounts.ForgotPasswordAsync(email);
        busy = false;
        switch (result)
        {
            case OwnerActionResult.Succeeded:
                done = true;
                break;
            case OwnerActionResult.FieldErrors fields:
                emailError = fields.Errors.GetValueOrDefault("email") ?? "Enter a valid email address.";
                break;
            case OwnerActionResult.Failed failed:
                formError = failed.Message;
                break;
        }
    }
}
