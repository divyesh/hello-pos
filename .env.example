# Hello POS local environment settings (feature 002).
# Development placeholders only. `scripts/env` copies this file to `.env` on first use;
# `.env` is git-ignored: put your own local values there and never commit it.

# PostgreSQL setup (administrator) login: used only to initialise the database.
POSTGRES_USER=hellopos_admin
POSTGRES_PASSWORD=change-me-admin

# Application database and its least-privilege login (used by the API).
HELLOPOS_DB_NAME=hellopos
HELLOPOS_DB_APP_USER=hellopos_app
HELLOPOS_DB_APP_PASSWORD=change-me-app

# Migrator login (feature 003): owns schema "pos" and applies migrations. Never used by the API.
HELLOPOS_DB_MIGRATOR_USER=hellopos_migrator
HELLOPOS_DB_MIGRATOR_PASSWORD=change-me-migrator

# Address published ports bind to. Keep 127.0.0.1; use 0.0.0.0 only to test on a physical
# Android device on your network (Seq has no login locally).
HELLOPOS_BIND_ADDRESS=127.0.0.1

# Host ports.
HELLOPOS_PG_PORT=5432
HELLOPOS_MOCK_PORT=4010
HELLOPOS_SEQ_PORT=5341
HELLOPOS_API_PORT=5080
